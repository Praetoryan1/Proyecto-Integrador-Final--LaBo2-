{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Trazo: depurar MVC",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Trazo: compilar",
      "program": "${workspaceFolder}/src/Trazo.Web/bin/Debug/net10.0/Trazo.Web.dll",
      "cwd": "${workspaceFolder}/src/Trazo.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7280;http://localhost:5079"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
