{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Trazo: compilar",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "Trazo.sln"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Trazo: ejecutar",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/Trazo.Web",
        "--launch-profile",
        "https"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "Trazo: pruebas unitarias",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "Trazo.sln"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
