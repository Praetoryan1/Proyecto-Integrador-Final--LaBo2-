@model PerfilPublicoModel
@{
    ViewData["Title"] = Model.Nombre;
    var accent = Array.IndexOf(Trazo.Web.Controllers.PerfilController.Acentos, Model.Acento);
}
<section class="profile-surface theme-@Model.Tema.ToString().ToLowerInvariant() accent-@accent layout-@Model.Disposicion.ToString().ToLowerInvariant()">
<div class="profile-heading"><div class="profile-identity">
    @if (Model.TieneAvatar) { <img class="profile-avatar" src="@Url.Action("Avatar", "Perfil", new { usuario = Model.Usuario })" alt="Avatar de @Model.Nombre" width="96" height="96" /> }
    else { <span class="profile-avatar avatar-placeholder" aria-hidden="true">@Model.Nombre[..1]</span> }
    <div><span class="eyebrow">PORTAFOLIO / @Model.Usuario</span><h1>@Model.Nombre</h1><p>@Model.Especialidad</p></div></div>
    @if (Model.Disponible) { <span class="availability"><span class="status-dot"></span> Disponible para trabajar</span> }
</div>
@if (!Model.Propio) {
    <div class="social-controls">
    @if (User.IsInRole(Roles.Creador)) {
        <form asp-controller="Comunidad" asp-action="@(Model.Siguiendo ? "DejarDeSeguir" : "Seguir")" asp-route-usuario="@Model.Usuario" method="post">
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
            <button type="submit" class="btn btn-outline-light">@(Model.Siguiendo ? "Dejar de seguir" : "Seguir creador")</button>
        </form>
        <a asp-controller="Comunidad" asp-action="Seguidos" class="quiet-link">Ver mis seguidos ↗</a>
    } else if (User.Identity?.IsAuthenticated != true) {
        <a asp-controller="Cuenta" asp-action="Ingresar" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-light">Ingresar para seguir</a>
    }
    <span class="field-help">Seguir no cambia los permisos de sus publicaciones.</span>
    </div>
}
<div class="profile-bio">@Model.Biografia</div>
<div class="contact-links">
    @if (!string.IsNullOrWhiteSpace(Model.EmailContacto)) { <a href="mailto:@Model.EmailContacto" class="btn btn-lime">Contactar por email ↗</a> }
    @foreach (var link in Model.Enlaces) { <a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Etiqueta ↗</a> }
    @if (Model.Propio) { <a asp-action="Editar" class="btn btn-outline-light">Editar mi perfil</a><a asp-controller="Destacados" asp-action="Index">Elegir destacados ↗</a> }
</div>
@if (Model.Propio) { <p class="muted">Esta es tu vista de propietario. Las publicaciones privadas que ves acá no se muestran a otras cuentas. Los borradores y archivados se consultan desde el editor.</p> }
@if (Model.Destacados.Count > 0) {
    <section id="obras-destacadas" aria-labelledby="titulo-destacados"><div class="section-heading"><h2 id="titulo-destacados">Obras destacadas<span class="accent">.</span></h2><span class="muted">Selección del creador</span></div>
        <partial name="_Tarjetas" model="Model.Destacados" />
    </section>
}
<div class="section-heading"><h2>Actividad<span class="accent">.</span></h2><span class="muted">@Model.Publicaciones.Total resultados</span></div>
<partial name="_Tarjetas" model="Model.Publicaciones.Items" />
<partial name="_Pagination" model="@((Model.Publicaciones.Numero, Model.Publicaciones.Paginas, Model.Publicaciones.Total))" />
</section>
