@model EtiquetaModel
@{ var id = ViewData["Id"]; ViewData["Title"] = id is null ? "Nueva etiqueta" : "Editar etiqueta"; }
<section class="reading-page"><a asp-action="Index" class="quiet-link">← Volver a etiquetas</a><h1 class="mt-4">@ViewData["Title"]</h1><div class="form-panel"><form method="post" asp-action="@(id is null ? "Crear" : "Editar")" asp-route-id="@id"><div asp-validation-summary="All" class="validation"></div><div class="field"><label asp-for="Nombre"></label><input asp-for="Nombre" class="form-control" /></div><div class="form-check field"><input asp-for="Activa" class="form-check-input" /><label asp-for="Activa" class="form-check-label"></label></div><button type="submit" class="btn btn-lime">Guardar etiqueta</button></form></div></section>
