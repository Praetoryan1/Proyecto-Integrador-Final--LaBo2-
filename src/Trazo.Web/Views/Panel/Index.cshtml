@model PanelModel
@{ ViewData["Title"] = "Mi estudio"; }
<section class="page-heading"><span class="eyebrow">MI ESTUDIO</span><h1>Hola, @Model.Nombre<span class="accent">.</span></h1><p>Este es tu espacio. Dale forma a cómo querés presentarte.</p></section>
<div class="stats-grid"><div><span>PUBLICACIONES</span><strong>@Model.Publicaciones</strong></div><div><span>FAVORITOS GUARDADOS</span><strong>@Model.Favoritos</strong></div><div><span>CREADORES QUE SEGUÍS</span><strong>@Model.Seguidos</strong></div></div>
<a asp-controller="Publicaciones" asp-action="Index" class="btn btn-lime mb-4">Administrar mis publicaciones ↗</a>
<div class="social-controls"><a asp-controller="Comunidad" asp-action="Favoritos" class="btn btn-outline-light">Mis favoritos ↗</a><a asp-controller="Comunidad" asp-action="Seguidos" class="btn btn-outline-light">Creadores que sigo ↗</a><span class="field-help">Los contadores incluyen solo contenido disponible para vos.</span></div>
<div class="action-grid"><a asp-controller="Perfil" asp-action="Editar" class="action-card"><span class="eyebrow">01 / IDENTIDAD</span><h2>Editá tu perfil ↗</h2><p>Avatar, presentación, contacto y apariencia.</p></a><a asp-controller="Perfil" asp-action="Ver" asp-route-usuario="@Model.Usuario" class="action-card"><span class="eyebrow">02 / PORTAFOLIO</span><h2>Visitá tu espacio ↗</h2><p>Recorré tu perfil y las publicaciones que podés ver.</p></a></div>
