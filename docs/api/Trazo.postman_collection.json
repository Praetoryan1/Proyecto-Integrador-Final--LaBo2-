          "raw": "{\n  \"titulo\": \"Colección Postman · {{marca}}\",\n  \"texto\": \"Publicación temporal para comprobar la API JWT.\",\n  \"tipo\": 1,\n  \"estadoEditorial\": 0,\n  \"visibilidad\": 2,\n  \"etiquetaIds\": [\n    {{etiquetaId}}\n  ]\n}",
