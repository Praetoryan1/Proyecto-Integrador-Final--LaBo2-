            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/token",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ana@trazo.test\",\n  \"password\": \"Incorrecta.Demo123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
