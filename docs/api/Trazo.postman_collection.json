    {
      "name": "03 · Emitir JWT de Ana",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('marca', String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const respuestaTrazo = pm.response.json();",
              "pm.test('JWT y duración de 10 minutos', () => { pm.expect(respuestaTrazo.accessToken.split('.')).to.have.lengthOf(3); pm.expect(respuestaTrazo.tokenType).to.eql('Bearer'); pm.expect(respuestaTrazo.expiresIn).to.eql(600); });",
              "pm.test('Sin cookie y sin caché', () => { pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false); pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });",
              "pm.variables.set('token', respuestaTrazo.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/token",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ana@trazo.test\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 · Buscar etiquetas relacionadas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const respuestaTrazo=pm.response.json(); pm.test('Selector paginado', () => { pm.expect(respuestaTrazo.tamano).to.eql(10); pm.expect(respuestaTrazo.items.length).to.be.within(1,10); });",
              "pm.variables.set('etiquetaId', respuestaTrazo.items[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/etiquetas?q=Anima&pagina=1"
      }
    },
    {
      "name": "05 · Crear publicación propia",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const respuestaTrazo=pm.response.json(); pm.variables.set('id', respuestaTrazo.id); pm.variables.set('version', respuestaTrazo.version);",
              "pm.test('Location y relación persistida', () => { pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/publicaciones/'+respuestaTrazo.id); pm.expect(respuestaTrazo.etiquetas).to.have.lengthOf(1); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
